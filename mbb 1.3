def verify_installation():
    print("\n🔒 Running static verification...")
    issues = []
    # Check custom_providers.json for api_key field
    custom_providers_file = BASE / "data" / "custom_providers.json"
    if custom_providers_file.exists():
        try:
            with open(custom_providers_file) as f:
                data = json.load(f)
                for name, cfg in data.items():
                    if "api_key" in cfg:
                        issues.append(f"custom_providers.json contains api_key for provider '{name}'")
        except Exception as e:
            issues.append(f"Could not parse custom_providers.json: {e}")

    # Check Python files for hard-coded API keys (pattern: "sk-", "api_key =", etc.)
    for py_file in BASE.rglob("*.py"):
        if "keychain" in str(py_file) or "credentials" in str(py_file):
            continue  # skip these files
        try:
            content = py_file.read_text(encoding="utf-8")
            # Look for patterns like 'api_key = "sk-...' or 'api_key = ' followed by quote
            if re.search(r'api_key\s*=\s*["\'][^"\']*["\']', content) and "KeychainManager" not in content:
                # Check if it's a test or comment
                if not re.search(r'#.*api_key\s*=', content):
                    issues.append(f"Potential hard-coded API key in {py_file.relative_to(BASE)}")
        except Exception:
            pass

    if issues:
        print("❌ Verification failed:")
        for issue in issues:
            print(f"  - {issue}")
        sys.exit(1)
    else:
        print("✅ Static verification passed. No plaintext secrets found.")

