\"\"\"Routes to the correct LLM provider – supports built‑in and custom.\"\"\"
import json
from pathlib import Path
from typing import Optional, Dict
from ..providers.base import LLMProvider
from ..providers.claude import ClaudeAdapter
from ..providers.openai import OpenAIAdapter
from ..providers.generic_openai import GenericOpenAIAdapter
from .credentials import CredentialManager

class ProviderRouter:
    def __init__(self, creds: CredentialManager, custom_providers_path: Path):
        self.creds = creds
        self.custom_providers_path = custom_providers_path
        self._adapters = {}
        self._custom_provider_configs = self._load_custom_providers()

    def _load_custom_providers(self) -> Dict[str, Dict]:
        if self.custom_providers_path.exists():
            with open(self.custom_providers_path) as f:
                return json.load(f)
        return {}

    def _save_custom_providers(self):
        # Do NOT store api_key in the JSON
        self.custom_providers_path.parent.mkdir(parents=True, exist_ok=True)
        # Ensure no api_key field is present
        safe_config = {name: {k: v for k, v in cfg.items() if k != "api_key"} for name, cfg in self._custom_provider_configs.items()}
        with open(self.custom_providers_path, "w") as f:
            json.dump(safe_config, f, indent=2)

    def add_custom_provider(self, name: str, base_url: str, model: str):
        # API key is stored separately via CredentialManager; we do not store it here
        self._custom_provider_configs[name] = {
            "base_url": base_url,
            "model": model
        }
        self._save_custom_providers()
        if name in self._adapters:
            del self._adapters[name]

    def delete_custom_provider(self, name: str):
        if name in self._custom_provider_configs:
            del self._custom_provider_configs[name]
            self._save_custom_providers()
            if name in self._adapters:
                del self._adapters[name]

    def get_provider(self, provider_name: str, model: Optional[str] = None) -> LLMProvider:
        if provider_name in self._custom_provider_configs:
            if provider_name not in self._adapters:
                config = self._custom_provider_configs[provider_name]
                # Retrieve API key from Keychain using CredentialManager
                api_key = self.creds.get_key(f"custom_{provider_name}")
                if api_key is None:
                    api_key = ""  # Some providers may not require a key
                base_url = config["base_url"]
                default_model = config.get("model", "default")
                self._adapters[provider_name] = GenericOpenAIAdapter(
                    api_key=api_key,
                    base_url=base_url,
                    default_model=default_model
                )
            return self._adapters[provider_name]

        # Built-in providers
        if provider_name not in self._adapters:
            api_key = self.creds.get_key(provider_name)
            if not api_key:
                raise ValueError(f"No API key for provider: {provider_name}")
            if provider_name == "claude":
                self._adapters[provider_name] = ClaudeAdapter(api_key)
            elif provider_name == "openai":
                self._adapters[provider_name] = OpenAIAdapter(api_key)
            elif provider_name == "gemini":
                raise ValueError("Gemini adapter not yet implemented")
            else:
                raise ValueError(f"Unknown provider: {provider_name}")
        return self._adapters[provider_name]

    def list_providers(self) -> list:
        built_in = ["claude", "openai", "gemini"]
        custom = list(self._custom_provider_configs.keys())
        return built_in + custom

    def get_custom_providers(self) -> Dict:
        # Return config without api_key (already not stored)
        return self._custom_provider_configs
''')

