\"\"\"Fail‑closed policy engine – priority: DENY > APPROVAL > ALLOW.\"\"\"
from enum import Enum
from typing import Dict, Any, List

class Decision(Enum):
    ALLOW = "allow"
    DENY = "deny"
    REQUIRE_APPROVAL = "approval"

class PolicyEngine:
    def __init__(self):
        self._deny_rules: List[Dict] = []
        self._allow_rules: List[Dict] = []

    async def evaluate(self, agent: Dict, tool_name: str, args: Dict, context: Dict, tool_def: Dict = None) -> Decision:
        # 1. Unknown tool → DENY (fail‑closed)
        if tool_name not in context.get("available_tools", []):
            return Decision.DENY

        # 2. Human override → DENY
        if context.get("human_override", False):
            return Decision.DENY

        # 3. Global deny rules (evaluated before any agent permission)
        for rule in self._deny_rules:
            if self._matches(rule, agent, tool_name, args, context):
                return Decision.DENY

        # 4. Agent explicit permission
        agent_permission = agent.get("permissions", {}).get(tool_name)
        if agent_permission == "deny":
            return Decision.DENY
        elif agent_permission == "approval":
            return Decision.REQUIRE_APPROVAL

        # 5. Tool definition requires_approval (if provided)
        if tool_def and tool_def.get("requires_approval", False):
            return Decision.REQUIRE_APPROVAL

        # 6. Agent explicit "auto" → ALLOW (if no deny/approval above)
        if agent_permission == "auto":
            return Decision.ALLOW

        # 7. Global allow rules
        for rule in self._allow_rules:
            if self._matches(rule, agent, tool_name, args, context):
                return Decision.ALLOW

        # 8. Default: fail‑closed
        return Decision.DENY

    def _matches(self, rule, agent, tool_name, args, context):
        return False  # Placeholder for CEL/pattern matching
''')

