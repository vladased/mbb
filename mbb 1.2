\"\"\"Generic OpenAI-compatible adapter for custom providers.\"\"\"
import json
import httpx
from typing import AsyncIterator, Dict, Any, List
from .base import LLMProvider, ProviderRequest, ProviderEvent
from ..core.models import AssistantToolCall, Message, MessageRole

class GenericOpenAIAdapter(LLMProvider):
    def __init__(self, api_key: str, base_url: str, default_model: str):
        self.api_key = api_key
        self.base_url = base_url.rstrip('/')
        self._default_model = default_model

    def get_model_name(self) -> str:
        return self._default_model

    def get_context_limit(self) -> int:
        return 128000

    def _translate_tools(self, bb_tools: List[Dict]) -> List[Dict]:
        return [{
            "type": "function",
            "function": {
                "name": t["name"],
                "description": t.get("description", ""),
                "parameters": t.get("parameters", {"type": "object", "properties": {}})
            }
        } for t in bb_tools]

    def _translate_messages(self, messages: List[Message]) -> List[Dict]:
        translated = []
        for msg in messages:
            if msg.role == MessageRole.SYSTEM:
                translated.append({"role": "system", "content": msg.content})
            elif msg.role == MessageRole.USER:
                translated.append({"role": "user", "content": msg.content})
            elif msg.role == MessageRole.ASSISTANT:
                if msg.tool_calls:
                    tool_calls = [{
                        "id": tc.id,
                        "type": "function",
                        "function": {
                            "name": tc.name,
                            "arguments": json.dumps(tc.arguments)
                        }
                    } for tc in msg.tool_calls]
                    translated.append({
                        "role": "assistant",
                        "content": msg.content or None,
                        "tool_calls": tool_calls
                    })
                else:
                    translated.append({"role": "assistant", "content": msg.content})
            elif msg.role == MessageRole.TOOL:
                translated.append({
                    "role": "tool",
                    "tool_call_id": msg.tool_call_id,
                    "content": msg.content or "Success"
                })
        return translated

    async def stream(self, request: ProviderRequest) -> AsyncIterator[ProviderEvent]:
        url = f"{self.base_url}/chat/completions"
        model = request.model if request.model else self._default_model
        payload = {
            "model": model,
            "messages": self._translate_messages(request.conversation),
            "max_tokens": request.max_tokens,
            "temperature": request.temperature,
            "stream": True
        }
        tools = self._translate_tools(request.tools)
        if tools:
            payload["tools"] = tools
            payload["tool_choice"] = "auto"

        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json"
        }

        async with httpx.AsyncClient(timeout=60.0) as client:
            async with client.stream("POST", url, json=payload, headers=headers) as response:
                if response.status_code != 200:
                    error_text = await response.aread()
                    yield ProviderEvent(type="error", error=f"Custom provider error {response.status_code}: {error_text.decode()}")
                    return

                tool_calls_in_progress = {}
                current_text = ""
                async for line in response.aiter_lines():
                    if not line.startswith("data: "):
                        continue
                    data_str = line[6:].strip()
                    if data_str == "[DONE]":
                        continue
                    try:
                        data = json.loads(data_str)
                    except:
                        continue

                    if "choices" not in data:
                        continue

                    choice = data["choices"][0]
                    delta = choice.get("delta", {})

                    if "content" in delta and delta["content"]:
                        current_text += delta["content"]
                        yield ProviderEvent(type="text", text=delta["content"])

                    if "tool_calls" in delta:
                        for tc in delta["tool_calls"]:
                            idx = tc.get("index", 0)
                            if idx not in tool_calls_in_progress:
                                tool_calls_in_progress[idx] = {
                                    "id": tc.get("id", ""),
                                    "name": tc.get("function", {}).get("name", ""),
                                    "arguments": ""
                                }
                            if "function" in tc and "arguments" in tc["function"]:
                                tool_calls_in_progress[idx]["arguments"] += tc["function"]["arguments"]

                    finish_reason = choice.get("finish_reason")
                    if finish_reason == "tool_calls":
                        for idx, call in list(tool_calls_in_progress.items()):
                            try:
                                args = json.loads(call["arguments"]) if call["arguments"] else {}
                            except:
                                args = {}
                            yield ProviderEvent(
                                type="tool_call",
