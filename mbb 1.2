                handler=weaver_link
            ))
            self.gateway.register_tool(ToolDefinition(
                name="weaver.search", risk="safe", requires_approval=False,
                description="Raw search returning full results",
                parameters={"type":"object","properties":{"query":{"type":"string"}}},
                handler=weaver_search
            ))

        async def shortcut_run(args):
            name = args.get("name", "")
            params = args.get("params", {})
            from ..ios.shortcuts import ShortcutsBridge
            return await ShortcutsBridge.run_shortcut(name, params)
        self.gateway.register_tool(ToolDefinition(
            name="shortcut.run", risk="sensitive", requires_approval=True,
            description="Run an iOS Shortcut",
            parameters={"type":"object","properties":{"name":{"type":"string"},"params":{"type":"object"}}},
            handler=shortcut_run
        ))

        async def notify_send(args):
            title = args.get("title", "BB")
            body = args.get("body", "")
            from ..ios.notifications import NotificationsBridge
            return await NotificationsBridge.send_notification(title, body)
        self.gateway.register_tool(ToolDefinition(
            name="notification.send", risk="observable", requires_approval=False,
            description="Send an immediate local notification",
            parameters={"type":"object","properties":{"title":{"type":"string","default":"BB"},"body":{"type":"string"}}},
            handler=notify_send
        ))
        async def notify_schedule(args):
            title = args.get("title", "BB")
            body = args.get("body", "")
            delay = args.get("delay_seconds", 60)
            from ..ios.notifications import NotificationsBridge
            return await NotificationsBridge.schedule_notification(title, body, delay)
        self.gateway.register_tool(ToolDefinition(
            name="notification.schedule", risk="observable", requires_approval=False,
            description="Schedule a notification after a delay (placeholder)",
            parameters={"type":"object","properties":{"title":{"type":"string","default":"BB"},"body":{"type":"string"},"delay_seconds":{"type":"integer","default":60}}},
            handler=notify_schedule
        ))

    def _load_agents(self):
        from .agent import Agent, AgentWorkspace
        workspace = AgentWorkspace("fable", self.data_path / "agents")
        fable = Agent(
            id="fable",
            name="Fable",
            provider="claude",
            model="claude-3-5-sonnet-20241022",
            system_prompt="You are Fable, a thoughtful and capable personal AI assistant. You help the user organize knowledge, make decisions, and automate tasks.",
            workspace=workspace,
            permitted_tools=[
                "weaver.retrieve", "weaver.hot", "weaver.orient",
                "weaver.capture", "weaver.update", "weaver.link",
                "weaver.search", "shortcut.run",
                "notification.send", "notification.schedule"
            ],
            permissions={
                "weaver.retrieve": "auto",
                "weaver.hot": "auto",
                "weaver.orient": "auto",
                "weaver.capture": "auto",
                "weaver.update": "auto",
                "weaver.link": "auto",
                "weaver.search": "auto",
                "shortcut.run": "approval",
                "notification.send": "auto",
                "notification.schedule": "auto",
            }
        )
        self.agents["fable"] = fable

    def get_agent(self, agent_id: str) -> Optional[Agent]:
        return self.agents.get(agent_id)

    def get_tool_names(self) -> list:
        return self.gateway.get_tool_names()

    def get_tool_definitions(self) -> list:
        return self.gateway.get_tool_definitions()

    def is_human_override(self) -> bool:
        return self._human_override

    async def set_human_override(self, enabled: bool):
        self._human_override = enabled
        if enabled:
            self.gateway.cancel_all_pending()
            await self.events.emit("human.took_wheel", {"enabled": True}, broadcast=True)
        else:
            await self.events.emit("human.released_wheel", {"enabled": False}, broadcast=True)

    async def process(self, user_input: str, session_id: str, agent_id: str = "fable") -> AsyncIterator[ProviderEvent]:
        agent = self.get_agent(agent_id)
        if not agent:
            yield ProviderEvent(type="error", error=f"Agent '{agent_id}' not found")
            return

        session = self.sessions.get(session_id)
        if not session:
            session = self.sessions.create(agent_id, session_id)

        context_data = await self.context_builder.build(user_input, session, agent) if self.context_builder else {}
        system_prompt = self.context_builder.build_system_prompt(agent, context_data) if self.context_builder else agent.system_prompt

        conversation = Conversation()
        for msg in session.messages[-10:]:
            conversation.messages.append(msg)
        conversation.add_user(user_input)

        try:
            provider = self.router.get_provider(agent.provider, agent.model)
        except ValueError as e:
            yield ProviderEvent(type="error", error=str(e))
            return

        tool_defs = self.gateway.get_tool_definitions()
        permitted = set(agent.permitted_tools)
        filtered_tools = [t for t in tool_defs if t["name"] in permitted]

        max_iterations = 10
        iteration = 0

        while iteration < max_iterations:
            iteration += 1
            request = ProviderRequest(
                system=system_prompt,
                conversation=conversation.messages,
                tools=filtered_tools,
                model=agent.model or provider.get_model_name(),
                temperature=0.7,
                max_tokens=4096,
            )

            assistant_text = ""
            assistant_tool_calls = []
            tool_calls_in_round = []

            async for event in provider.stream(request):
                if event.type == "text":
                    assistant_text += event.text
                    yield ProviderEvent(type="text", text=event.text)

                elif event.type == "tool_call":
                    assistant_tool_calls.append(event.tool_call)
                    tool_calls_in_round.append(event.tool_call)

                elif event.type == "done":
                    if assistant_text or assistant_tool_calls:
                        conversation.add_assistant(
                            content=assistant_text or None,
                            tool_calls=assistant_tool_calls
                        )

                    if not tool_calls_in_round:
                        yield ProviderEvent(type="done")
                        return

                    for tc in tool_calls_in_round:
                        try:
                            context = {
                                "available_tools": self.get_tool_names(),
                                "human_override": self.is_human_override()
                            }
                            result = await self.gateway.execute(
                                agent=agent.__dict__,
                                tool_name=tc.name,
                                args=tc.arguments,
                                context=context
                            )
                            conversation.add_tool_result(ToolResult(
                                tool_call_id=tc.id,
                                name=tc.name,
                                result=result
                            ))
                            yield ProviderEvent(type="tool_result", tool_result=ToolResult(
                                tool_call_id=tc.id,
                                name=tc.name,
                                result=result
                            ))
                        except Exception as e:
                            conversation.add_tool_result(ToolResult(
                                tool_call_id=tc.id,
                                name=tc.name,
                                error=str(e)
                            ))
                            yield ProviderEvent(type="tool_result", tool_result=ToolResult(
                                tool_call_id=tc.id,
                                name=tc.name,
                                error=str(e)
                            ))
                    break

                elif event.type == "error":
                    yield event
                    return

        if iteration >= max_iterations:
            yield ProviderEvent(type="error", error="Max tool iterations reached")
''')

