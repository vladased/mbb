write_file("bb/gateway/policy.py", '''
\"\"\"Fail‑closed policy engine.\"\"\"
from enum import Enum
from typing import Dict, Any, List

class Decision(Enum):
    ALLOW = "allow"
    DENY = "deny"
    REQUIRE_APPROVAL = "approval"

class PolicyEngine:
    def __init__(self):
        self._deny_rules: List[Dict] = []
        self._allow_rules: List[Dict] = []

    async def evaluate(self, agent: Dict, tool_name: str, args: Dict, context: Dict) -> Decision:
        if tool_name not in context.get("available_tools", []):
            return Decision.DENY
        if context.get("human_override", False):
            return Decision.DENY
        agent_permission = agent.get("permissions", {}).get(tool_name)
        if agent_permission == "deny":
            return Decision.DENY
        elif agent_permission == "approval":
            return Decision.REQUIRE_APPROVAL
        elif agent_permission == "auto":
            return Decision.ALLOW
        for rule in self._deny_rules:
            if self._matches(rule, agent, tool_name, args, context):
                return Decision.DENY
        for rule in self._allow_rules:
            if self._matches(rule, agent, tool_name, args, context):
                return Decision.ALLOW
        return Decision.DENY

    def _matches(self, rule, agent, tool_name, args, context):
        return False
''')

write_file("bb/gateway/audit.py", '''
\"\"\"Audit logger with state machine.\"\"\"
import json
import uuid
import sqlite3
from pathlib import Path
from datetime import datetime
from typing import Any, Optional

class AuditLogger:
    def __init__(self, storage_path: Path):
        self.db_path = storage_path / "audit.db"
        self._init_db()

    def _init_db(self):
        conn = sqlite3.connect(self.db_path)
        conn.execute('''
            CREATE TABLE IF NOT EXISTS audit (
                id TEXT PRIMARY KEY,
                timestamp TEXT,
                agent_id TEXT,
                tool TEXT,
                args TEXT,
                decision TEXT,
                status TEXT,
                result TEXT,
                error TEXT
            )
        ''')
        conn.commit()
        conn.close()

    def record_decision(self, agent_id: str, tool: str, args: dict, decision: str, reason: str = "") -> str:
        audit_id = str(uuid.uuid4())
        conn = sqlite3.connect(self.db_path)
        conn.execute(
            "INSERT INTO audit (id, timestamp, agent_id, tool, args, decision, status) VALUES (?, ?, ?, ?, ?, ?, ?)",
            (audit_id, datetime.now().isoformat(), agent_id, tool, json.dumps(args), decision, "DECIDED")
        )
        conn.commit()
        conn.close()
        return audit_id

    def update_status(self, audit_id: str, status: str, result: Any = None, error: Optional[str] = None):
        conn = sqlite3.connect(self.db_path)
        conn.execute(
            "UPDATE audit SET status = ?, result = ?, error = ? WHERE id = ?",
            (status, json.dumps(result) if result is not None else None, error, audit_id)
        )
        conn.commit()
        conn.close()

    def get_recent(self, limit: int = 50) -> list:
        conn = sqlite3.connect(self.db_path)
        conn.row_factory = sqlite3.Row
        cursor = conn.execute("SELECT * FROM audit ORDER BY timestamp DESC LIMIT ?", (limit,))
        rows = cursor.fetchall()
        conn.close()
        return [dict(row) for row in rows]
''')

write_file("bb/gateway/tool_gateway.py", '''
\"\"\"Single action boundary – the Gateway.\"\"\"
import asyncio
import uuid
from typing import Dict, Any, Callable, Awaitable, Optional, List
from dataclasses import dataclass, field
from datetime import datetime
from .policy import PolicyEngine, Decision
from .audit import AuditLogger

class HumanOverrideError(Exception):
    pass

class ToolDeniedError(Exception):
    pass

@dataclass
class ToolDefinition:
    name: str
    description: str
    parameters: dict
    handler: Callable[[dict], Awaitable[Any]]
    risk: str = "safe"
    requires_approval: bool = False
    destructive: bool = False
    scopes: List[str] = field(default_factory=list)
    capabilities: List[str] = field(default_factory=list)

@dataclass
class PendingApproval:
    id: str
    audit_id: str
    agent_id: str
    tool_name: str
    args: dict
    future: asyncio.Future
    created_at: str = field(default_factory=lambda: datetime.now().isoformat())

class ToolGateway:
    def __init__(self, policy: PolicyEngine, audit: AuditLogger):
        self.policy = policy
        self.audit = audit
        self._tools: Dict[str, ToolDefinition] = {}
        self._pending_approvals: Dict[str, PendingApproval] = {}
        self._human_override_check = None

    def set_human_override_check(self, func):
        self._human_override_check = func

    def register_tool(self, definition: ToolDefinition):
        self._tools[definition.name] = definition

    def get_tool_names(self) -> List[str]:
        return list(self._tools.keys())

    def get_tool_definitions(self) -> list:
        return [
            {
                "name": t.name,
                "description": t.description,
                "parameters": t.parameters,
                "scopes": t.scopes,
                "capabilities": t.capabilities,
            }
            for t in self._tools.values()
        ]

    async def execute(self, agent: dict, tool_name: str, args: dict, context: dict = None) -> Any:
        context = context or {}
        if self._human_override_check and self._human_override_check():
            raise HumanOverrideError("Human has taken the wheel.")

        tool = self._tools.get(tool_name)
        if not tool:
            audit_id = self.audit.record_decision(agent.get("id","unknown"), tool_name, args, "DENY", "Unknown tool")
            self.audit.update_status(audit_id, "DENIED", error="Unknown tool")
            raise ValueError(f"Unknown tool: {tool_name}")

        decision = await self.policy.evaluate(agent, tool_name, args, context)

        if decision == Decision.DENY:
            audit_id = self.audit.record_decision(agent.get("id","unknown"), tool_name, args, "DENY", "Policy denied")
            self.audit.update_status(audit_id, "DENIED", error="Denied by policy")
            raise ToolDeniedError(f"Tool '{tool_name}' denied by policy")

        if decision == Decision.REQUIRE_APPROVAL or (tool.requires_approval and agent.get("permissions",{}).get(tool_name) != "deny"):
            audit_id = self.audit.record_decision(agent.get("id","unknown"), tool_name, args, "APPROVAL_REQUIRED")
            approval_id = await self._request_approval(agent, tool_name, args, audit_id)
            try:
                await self._wait_for_approval(approval_id)
                self.audit.update_status(audit_id, "APPROVED")
            except asyncio.CancelledError:
                self.audit.update_status(audit_id, "DENIED", error="Approval cancelled")
                raise
            except Exception as e:
                self.audit.update_status(audit_id, "DENIED", error=str(e))
                raise
        else:
            audit_id = self.audit.record_decision(agent.get("id","unknown"), tool_name, args, "ALLOW")

        self.audit.update_status(audit_id, "EXECUTING")
        try:
            result = await tool.handler(args)
            self.audit.update_status(audit_id, "SUCCESS", result=result)
            return result
        except Exception as e:
            self.audit.update_status(audit_id, "FAILED", error=str(e))
            raise

    async def _request_approval(self, agent: dict, tool_name: str, args: dict, audit_id: str) -> str:
        approval_id = str(uuid.uuid4())
        future = asyncio.Future()
        self._pending_approvals[approval_id] = PendingApproval(
            id=approval_id,
            audit_id=audit_id,
            agent_id=agent.get("id","unknown"),
            tool_name=tool_name,
            args=args,
            future=future
        )
        return approval_id

    async def _wait_for_approval(self, approval_id: str):
        pending = self._pending_approvals.get(approval_id)
        if not pending:
            raise ValueError(f"Unknown approval: {approval_id}")
        await pending.future
        del self._pending_approvals[approval_id]

    def approve(self, approval_id: str):
        pending = self._pending_approvals.get(approval_id)
        if pending:
            pending.future.set_result(True)

    def deny_approval(self, approval_id: str):
        pending = self._pending_approvals.get(approval_id)
        if pending:
            pending.future.set_exception(ToolDeniedError("User denied approval"))

    def cancel_all_pending(self):
        for approval_id, pending in list(self._pending_approvals.items()):
            pending.future.cancel()
            del self._pending_approvals[approval_id]
''')

