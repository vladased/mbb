write_file("static/script.js", '''
const messagesContainer = document.getElementById('messages');
const inputField = document.getElementById('inputField');
const sendBtn = document.getElementById('sendBtn');
const wheelBtn = document.getElementById('wheelBtn');
const auditBtn = document.getElementById('auditBtn');
const settingsBtn = document.getElementById('settingsBtn');
const agentSelect = document.getElementById('agentSelect');

let sessionId = localStorage.getItem('sessionId') || crypto.randomUUID();
localStorage.setItem('sessionId', sessionId);
let authToken = localStorage.getItem('bbAuthToken') || '';
let currentAgent = 'fable';

function addMessage(text, role, extra = {}) {
    const div = document.createElement('div');
    div.className = `message ${role}`;
    if (role === 'assistant' && extra.partial) {
        div.classList.add('streaming');
        const tokenSpan = document.createElement('span');
        tokenSpan.className = 'token';
        tokenSpan.textContent = text;
        div.appendChild(tokenSpan);
    } else {
        div.textContent = text;
    }
    messagesContainer.appendChild(div);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
    return div;
}

function updateStreamingMessage(element, text) {
    const tokenSpan = element.querySelector('.token');
    if (tokenSpan) {
        tokenSpan.textContent += text;
    } else {
        const newSpan = document.createElement('span');
        newSpan.className = 'token';
        newSpan.textContent = text;
        element.appendChild(newSpan);
    }
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
}

async function sendMessage(text) {
    if (!text.trim()) return;
    addMessage(text, 'user');
    inputField.value = '';
    sendBtn.disabled = true;
    let currentMsg = null;
    try {
        const response = await fetch('/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-API-Key': authToken },
            body: JSON.stringify({
                text: text,
                session_id: sessionId,
                agent_id: currentAgent
            })
        });
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            const chunk = decoder.decode(value);
            const lines = chunk.split('\\n');
            for (const line of lines) {
                if (line.startsWith('data: ')) {
                    try {
                        const data = JSON.parse(line.slice(6));
                        handleEvent(data, currentMsg, (msg) => { currentMsg = msg; });
                    } catch (e) {}
                }
            }
        }
    } catch (error) {
        console.error('Error:', error);
        addMessage(`Error: ${error.message}`, 'assistant');
    } finally {
        sendBtn.disabled = false;
        inputField.focus();
    }
}

function handleEvent(data, currentMsg, setMsg) {
    switch (data.type) {
        case 'message':
            if (data.partial) {
                if (!currentMsg) {
                    const msg = addMessage('', 'assistant', { partial: true });
                    setMsg(msg);
                    updateStreamingMessage(msg, data.content);
                } else {
                    updateStreamingMessage(currentMsg, data.content);
                }
            } else {
                if (currentMsg) {
                    if (data.content) updateStreamingMessage(currentMsg, data.content);
                    currentMsg.classList.remove('streaming');
                } else {
                    addMessage(data.content, 'assistant');
                }
            }
            break;
        case 'tool.approval_required':
            showApprovalModal(data);
            break;
        case 'error':
            addMessage(`Error: ${data.content}`, 'assistant');
            break;
        case 'session.start':
            console.log('Session started:', data.session_id);
            break;
        case 'session.end':
            console.log('Session ended');
            break;
    }
}

function showApprovalModal(data) {
    const modal = document.getElementById('approvalModal');
    const details = document.getElementById('approvalDetails');
    details.textContent = JSON.stringify(data, null, 2);
    modal.classList.remove('hidden');
    document.getElementById('approveBtn').onclick = () => {
        fetch('/approve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-API-Key': authToken },
            body: JSON.stringify({ approval_id: data.approval_id, decision: 'allow' })
        });
        modal.classList.add('hidden');
    };
    document.getElementById('denyBtn').onclick = () => {
        fetch('/approve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-API-Key': authToken },
            body: JSON.stringify({ approval_id: data.approval_id, decision: 'deny' })
        });
        modal.classList.add('hidden');
    };
}

// ---- Settings UI ----
async function loadProviders() {
    try {
        const resp = await fetch('/providers', { headers: { 'X-API-Key': authToken } });
        const data = await resp.json();
        return data;
    } catch (e) {
        console.error('Failed to load providers:', e);
        return { providers: [], custom: {} };
    }
}

async function loadAgents() {
    try {
        const resp = await fetch('/agents', { headers: { 'X-API-Key': authToken } });
        const data = await resp.json();
        return data.agents || [];
    } catch (e) {
        console.error('Failed to load agents:', e);
        return [];
    }
}

async function refreshAgentSelect() {
    const agents = await loadAgents();
    agentSelect.innerHTML = '';
    agents.forEach(agent => {
        const opt = document.createElement('option');
        opt.value = agent.id;
        opt.textContent = `${agent.name} (${agent.provider}: ${agent.model})`;
        if (agent.id === currentAgent) opt.selected = true;
        agentSelect.appendChild(opt);
    });
}

agentSelect.addEventListener('change', async () => {
    currentAgent = agentSelect.value;
    // Optionally update the session's agent in the backend if needed
});

async function renderSettings() {
    const data = await loadProviders();
    const list = document.getElementById('providerList');
    const builtin = data.providers.filter(p => !data.custom[p]);
    const custom = Object.keys(data.custom);
    list.innerHTML = '';
    // Built-in
    builtin.forEach(p => {
        const div = document.createElement('div');
        div.className = 'provider-item';
        div.innerHTML = `<span class="name">${p}</span><span class="type">built-in</span>`;
        list.appendChild(div);
    });
    // Custom
    custom.forEach(name => {
        const cfg = data.custom[name];
        const div = document.createElement('div');
        div.className = 'provider-item';
        div.innerHTML = `
            <span class="name">${name}</span>
            <span class="type">custom (${cfg.base_url})</span>
            <button class="delete-btn" data-provider="${name}">Delete</button>
        `;
        list.appendChild(div);
    });
    // Add delete handlers
    list.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const name = btn.dataset.provider;
            if (!confirm(`Delete custom provider "${name}"?`)) return;
            await fetch(`/providers/custom/${name}`, {
                method: 'DELETE',
                headers: { 'X-API-Key': authToken }
            });
            await renderSettings();
            await refreshAgentSelect();
        });
    });
}

document.getElementById('addProviderForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('providerName').value.trim();
    const base_url = document.getElementById('providerBaseURL').value.trim();
    const api_key = document.getElementById('providerAPIKey').value.trim();
    const model = document.getElementById('providerModel').value.trim() || 'default';
    if (!name || !base_url) return;
    await fetch('/providers/custom', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-API-Key': authToken },
        body: JSON.stringify({ name, base_url, api_key, model })
    });
    document.getElementById('addProviderForm').reset();
    await renderSettings();
    await refreshAgentSelect();
});

settingsBtn.addEventListener('click', async () => {
    const modal = document.getElementById('settingsModal');
    await renderSettings();
    modal.classList.remove('hidden');
});
document.getElementById('closeSettingsBtn').addEventListener('click', () => {
    document.getElementById('settingsModal').classList.add('hidden');
});

sendBtn.addEventListener('click', () => sendMessage(inputField.value));
inputField.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage(inputField.value);
    }
});

wheelBtn.addEventListener('click', async () => {
    isHumanOverride = !isHumanOverride;
    const endpoint = isHumanOverride ? '/take_the_wheel' : '/release_the_wheel';
    await fetch(endpoint, { method: 'POST', headers: { 'X-API-Key': authToken } });
    wheelBtn.textContent = isHumanOverride ? 'Release Wheel' : 'Take The Wheel';
    wheelBtn.style.background = isHumanOverride ? '#a44' : '#222';
    addMessage(isHumanOverride ? '🔴 Human override enabled' : '🟢 Human override released', 'tool');
});

auditBtn.addEventListener('click', async () => {
    const modal = document.getElementById('auditModal');
    const list = document.getElementById('auditList');
    const response = await fetch('/audit', { headers: { 'X-API-Key': authToken } });
    const data = await response.json();
    list.innerHTML = data.logs.map(log =>
        `<div class="log-entry">[${log.timestamp.slice(0,19)}] ${log.agent_id} → ${log.tool} <span style="color: ${log.status === 'SUCCESS' ? '#4a9' : '#a44'}">${log.status}</span></div>`
    ).join('');
    modal.classList.remove('hidden');
    document.getElementById('closeAuditBtn').onclick = () => modal.classList.add('hidden');
});

if (!authToken) {
    const token = prompt('Enter BB local auth token (see Pyto console)');
    if (token) {
        authToken = token;
        localStorage.setItem('bbAuthToken', token);
    }
}

// Initial load
refreshAgentSelect();
''')

