\"\"\"WeaverAdapter – semantic interface to the vault.\"\"\"
from pathlib import Path
from typing import List, Optional
from datetime import datetime
from .parser import MarkdownParser
from .index import FTSIndex
from .vault import Vault

class WeaverAdapter:
    def __init__(self, vault_path: Path):
        self.vault_path = vault_path
        self.parser = MarkdownParser()
        self.index = FTSIndex(vault_path / ".bb_index.db")
        self.vault = Vault(vault_path)

    async def retrieve(self, query: str, limit: int = 5) -> List[str]:
        results = self.index.search(query, limit)
        return [r["snippet"] for r in results]

    async def hot(self) -> str:
        hot_path = self.vault_path / "_agent/context/HOT.md"
        if hot_path.exists():
            return hot_path.read_text(encoding="utf-8")
        return "No HOT.md found."

    async def orient(self) -> str:
        orient_path = self.vault_path / "ORIENT.md"
        if orient_path.exists():
            return orient_path.read_text(encoding="utf-8")
        return "No ORIENT.md found."

    async def capture(self, content: str, destination: str = "06-Inbox") -> str:
        ts = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        filename = f"{ts}.md"
        dest_path = self.vault_path / destination
        dest_path.mkdir(parents=True, exist_ok=True)
        file_path = dest_path / filename
        file_path.write_text(content, encoding="utf-8")
        parsed = self.parser.parse(content)
        self.index.index_file(file_path, parsed)
        return str(file_path)

    async def update(self, note_path: str, content: str) -> str:
        path = self.vault_path / note_path
        if not path.exists():
            raise ValueError(f"Note {note_path} does not exist")
        path.write_text(content, encoding="utf-8")
        parsed = self.parser.parse(content)
        self.index.index_file(path, parsed)
        return str(path)

    async def link(self, source: str, target: str) -> str:
        source_path = self.vault_path / source
        if not source_path.exists():
            raise ValueError(f"Source note {source} does not exist")
        content = source_path.read_text(encoding="utf-8")
        if f"[[{target}]]" in content:
            return f"Link already exists from {source} to {target}"
        new_content = content.rstrip() + f"\\n\\n[[{target}]]"
        source_path.write_text(new_content, encoding="utf-8")
        parsed = self.parser.parse(new_content)
        self.index.index_file(source_path, parsed)
        return f"Added link [[{target}]] to {source}"

    async def distill(self, source: str) -> str:
        return f"Distillation of {source} (not implemented)"

    async def consolidate(self) -> str:
        return "Consolidation triggered (not implemented)"

    async def index(self):
        self.index.reindex_all(self.vault_path, self.parser)

    async def reindex(self):
        self.index.reindex_all(self.vault_path, self.parser)

    async def search(self, query: str) -> List[dict]:
        return self.index.search(query)

    async def read(self, note_path: str) -> str:
        path = self.vault_path / note_path
        if path.exists():
            return path.read_text(encoding="utf-8")
        raise FileNotFoundError(f"Note {note_path} not found")

    async def list_directory(self, path: str = "") -> List[str]:
        full_path = self.vault_path / path
        if not full_path.exists():
            return []
        return [str(p.relative_to(self.vault_path)) for p in full_path.iterdir() if p.is_file()]
''')

write_file("bb/weaver/parser.py", '''
\"\"\"Markdown parser – extracts frontmatter, headings, links, tags.\"\"\"
import re
import yaml
from typing import Dict, List

class MarkdownParser:
    @staticmethod
    def parse(content: str) -> Dict:
        result = {
            "frontmatter": {},
            "title": "",
            "headings": [],
            "body": "",
            "links": [],
            "tags": [],
            "raw": content
        }
        frontmatter_match = re.match(r'^---\\s*\\n(.*?)\\n---\\s*\\n', content, re.DOTALL)
        if frontmatter_match:
            frontmatter_text = frontmatter_match.group(1)
            try:
                result["frontmatter"] = yaml.safe_load(frontmatter_text) or {}
            except:
                pass
            content = content[frontmatter_match.end():]
        title_match = re.search(r'^# (.+)$', content, re.MULTILINE)
        if title_match:
            result["title"] = title_match.group(1).strip()
        else:
            first_line = content.split('\\n')[0].strip()
            result["title"] = first_line if first_line else "Untitled"
        heading_pattern = re.compile(r'^(#{1,6})\\s+(.+)$', re.MULTILINE)
        result["headings"] = [
            {"level": len(m.group(1)), "text": m.group(2).strip()}
            for m in heading_pattern.finditer(content)
        ]
        link_pattern = re.compile(r'\\[\\[(.*?)\\]\\]')
        result["links"] = [m.group(1) for m in link_pattern.finditer(content)]
        if "tags" in result["frontmatter"]:
            tags = result["frontmatter"]["tags"]
            if isinstance(tags, str):
                result["tags"] = [t.strip() for t in tags.split(',')]
            elif isinstance(tags, list):
                result["tags"] = tags
        else:
            inline_tags = re.findall(r'#(\\w+)', content)
            result["tags"] = list(set(inline_tags))
        result["body"] = content.strip()
        return result

    @staticmethod
    def to_markdown(parsed: Dict) -> str:
        lines = []
        if parsed.get("frontmatter"):
            lines.append("---")
            lines.append(yaml.dump(parsed["frontmatter"], default_flow_style=False).strip())
            lines.append("---")
            lines.append("")
        if parsed.get("title"):
            lines.append(f"# {parsed['title']}")
            lines.append("")
        if parsed.get("body"):
            lines.append(parsed["body"])
        return "\\n".join(lines)
''')

write_file("bb/weaver/index.py", '''
\"\"\"FTS5 index for the vault.\"\"\"
import sqlite3
import json
from pathlib import Path
from typing import List, Dict
from datetime import datetime

class FTSIndex:
    def __init__(self, db_path: Path):
        self.db_path = db_path
        self._init_db()

    def _init_db(self):
        conn = sqlite3.connect(self.db_path)
        conn.execute("CREATE VIRTUAL TABLE IF NOT EXISTS fts USING fts5(path, title, body, content, tags, metadata, tokenize='porter unicode61')")
        conn.execute('''
            CREATE TABLE IF NOT EXISTS documents (
                path TEXT PRIMARY KEY,
                modified TEXT,
                title TEXT,
                tags TEXT,
                links TEXT,
                indexed_at TEXT
            )
        ''')
        conn.commit()
        conn.close()

    def index_file(self, path: Path, parsed: Dict):
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        cursor.execute('''
            INSERT OR REPLACE INTO fts (rowid, path, title, body, content, tags, metadata)
            VALUES ((SELECT rowid FROM fts WHERE path = ?), ?, ?, ?, ?, ?, ?)
        ''', (
            str(path),
            str(path),
            parsed.get("title",""),
            parsed.get("body",""),
            parsed.get("raw",""),
            ",".join(parsed.get("tags",[])),
            json.dumps(parsed.get("frontmatter",{}))
        ))
        cursor.execute('''
            INSERT OR REPLACE INTO documents (path, modified, title, tags, links, indexed_at)
            VALUES (?, ?, ?, ?, ?, ?)
        ''', (
            str(path),
            datetime.now().isoformat(),
            parsed.get("title",""),
            ",".join(parsed.get("tags",[])),
            ",".join(parsed.get("links",[])),
            datetime.now().isoformat()
        ))
        conn.commit()
        conn.close()

    def search(self, query: str, limit: int = 5) -> List[Dict]:
        conn = sqlite3.connect(self.db_path)
        conn.row_factory = sqlite3.Row
        cursor = conn.cursor()
        cursor.execute('''
            SELECT
                fts.path,
                fts.title,
                fts.body,
                fts.tags,
                fts.metadata,
                documents.modified,
                highlight(fts, 3, '[', ']') as snippet
            FROM fts
            JOIN documents ON documents.path = fts.path
            WHERE fts MATCH ?
            ORDER BY rank
            LIMIT ?
        ''', (query, limit))
        rows = cursor.fetchall()
        results = []
        for row in rows:
            results.append({
                "path": row["path"],
                "title": row["title"],
                "body": row["body"],
                "snippet": row["snippet"] if row["snippet"] else row["body"][:200],
                "tags": row["tags"].split(",") if row["tags"] else [],
                "metadata": json.loads(row["metadata"]) if row["metadata"] else {},
                "modified": row["modified"]
            })
        conn.close()
        return results

    def delete_file(self, path: Path):
        conn = sqlite3.connect(self.db_path)
        conn.execute("DELETE FROM fts WHERE path = ?", (str(path),))
        conn.execute("DELETE FROM documents WHERE path = ?", (str(path),))
        conn.commit()
        conn.close()

    def reindex_all(self, vault_path: Path, parser):
        conn = sqlite3.connect(self.db_path)
        conn.execute("DELETE FROM fts")
        conn.execute("DELETE FROM documents")
        conn.commit()
        conn.close()
        for md_file in vault_path.rglob("*.md"):
            try:
                content = md_file.read_text(encoding="utf-8")
                parsed = parser.parse(content)
                self.index_file(md_file, parsed)
            except Exception as e:
                print(f"Error indexing {md_file}: {e}")
''')

write_file("bb/weaver/vault.py", '''
\"\"\"Vault – file system operations.\"\"\"
from pathlib import Path
from typing import List

class Vault:
    def __init__(self, root: Path):
        self.root = root

    def read(self, rel_path: str) -> str:
        return (self.root / rel_path).read_text(encoding="utf-8")

    def write(self, rel_path: str, content: str):
        path = self.root / rel_path
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")

    def exists(self, rel_path: str) -> bool:
        return (self.root / rel_path).exists()

    def list(self, rel_path: str = "") -> List[str]:
        full = self.root / rel_path
        if not full.exists():
            return []
        return [str(p.relative_to(self.root)) for p in full.iterdir() if p.is_file()]

    def delete(self, rel_path: str):
        path = self.root / rel_path
        if path.exists():
            path.unlink()
''')

