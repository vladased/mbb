                description="Capture new content into the vault",
                parameters={"type":"object","properties":{"content":{"type":"string"},"dest":{"type":"string","default":"06-Inbox"}}},
                handler=weaver_capture
            ))
            self.gateway.register_tool(ToolDefinition(
                name="weaver.update", risk="observable", requires_approval=False,
