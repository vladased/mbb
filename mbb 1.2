\"\"\"Context builder – assembles system prompt and relevant memory.\"\"\"
from typing import Dict, Any, List, Optional
from .session import Session
from .agent import Agent
from ..weaver.adapter import WeaverAdapter

class ContextBuilder:
    def __init__(self, weaver: WeaverAdapter):
        self.weaver = weaver

    async def build(self, user_input: str, session: Session, agent: Agent) -> Dict[str, Any]:
        context = {
            "orientation": "",
            "hot": "",
            "memories": [],
            "task": user_input,
            "conversation": session.messages[-10:] if session.messages else [],
            "available_tools": agent.permitted_tools
        }
        try:
            context["hot"] = await self.weaver.hot()
        except Exception:
            context["hot"] = "No HOT set."
        try:
            context["orientation"] = await self.weaver.orient()
        except Exception:
            context["orientation"] = "No ORIENT set."
        try:
            context["memories"] = await self.weaver.retrieve(user_input, budget=3)
        except Exception:
            context["memories"] = []
        return context

    def build_system_prompt(self, agent: Agent, context: Dict[str, Any]) -> str:
        orientation = context.get("orientation", "")
        hot = context.get("hot", "")
        memories = context.get("memories", [])
        available_tools = context.get("available_tools", [])
        tools_description = "\\n".join([f"- {tool}" for tool in available_tools]) if available_tools else "No tools available."
        return f'''You are {agent.name}, a personal AI assistant operating inside BlackBox (BB).

## BB Environment

You are not just a chat model. You are a coworker with access to a governed tool system.

### Context Weaver Orientation
{orientation}

### Current Hot Context
{hot}

### Relevant Memories
{chr(10).join([f"- {m}" for m in memories]) if memories else "No relevant memories retrieved."}

### Your Available Tools
{tools_description}

## Your Role
{agent.system_prompt}

## Important Rules
1. You can request tool calls when you need information or want to take action.
2. All tool calls go through the BB Tool Gateway, which enforces policy and audit.
3. You cannot access the filesystem directly. You must use the BB tools.
4. Your workspace is isolated from other agents.
5. The vault is the persistent cognitive substrate.

## Response Style
Be concise, thoughtful, and helpful. Use tools when appropriate.
'''
''')

