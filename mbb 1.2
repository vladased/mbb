write_file("bb/core/runtime.py", '''
\"\"\"BB Runtime – orchestrates the entire agent loop.\"\"\"
import asyncio
import json
from typing import Optional, Dict, Any, AsyncIterator
from pathlib import Path

from .event_bus import EventBus
from .session import SessionManager
from .agent import Agent, AgentWorkspace
from .provider_router import ProviderRouter
from .context_builder import ContextBuilder
from .credentials import CredentialManager
from .models import Conversation, AssistantToolCall, ToolResult, Message, MessageRole
from ..gateway.tool_gateway import ToolGateway, ToolDefinition
from ..gateway.policy import PolicyEngine
from ..gateway.audit import AuditLogger
from ..weaver.adapter import WeaverAdapter
from ..providers.base import ProviderRequest, ProviderEvent

class BBRuntime:
    def __init__(self, data_path: Path, vault_path: Path):
        self.data_path = data_path
        self.vault_path = vault_path

        self.events = EventBus()
        self.creds = CredentialManager()
        self.policy = PolicyEngine()
        self.audit = AuditLogger(data_path)
        self.gateway = ToolGateway(self.policy, self.audit)
        self.gateway.set_human_override_check(self.is_human_override)
        self.sessions = SessionManager()
        self.agents = {}
        self.custom_providers_path = data_path / "custom_providers.json"
        self.router = ProviderRouter(self.creds, self.custom_providers_path)
        self.weaver = WeaverAdapter(vault_path) if vault_path.exists() else None
        self.context_builder = ContextBuilder(self.weaver) if self.weaver else None

        self._human_override = False
        self._running = False

    async def start(self):
        self._running = True
        self._register_core_tools()
        self._load_agents()
        if self.weaver:
            await self.weaver.index()

    async def stop(self):
        self._running = False
        self.gateway.cancel_all_pending()

    def _register_core_tools(self):
        if self.weaver:
            async def weaver_retrieve(args):
                query = args.get("query", "")
                limit = args.get("limit", 3)
                results = await self.weaver.retrieve(query, limit)
                return "\\n\\n".join(results)

            async def weaver_hot(args):
                return await self.weaver.hot()

            async def weaver_orient(args):
                return await self.weaver.orient()

            async def weaver_capture(args):
                content = args.get("content", "")
                dest = args.get("dest", "06-Inbox")
                path = await self.weaver.capture(content, dest)
                return f"Captured to: {path}"

            async def weaver_update(args):
                note = args.get("note", "")
                content = args.get("content", "")
                path = await self.weaver.update(note, content)
                return f"Updated: {path}"

            async def weaver_link(args):
                source = args.get("source", "")
                target = args.get("target", "")
                msg = await self.weaver.link(source, target)
                return msg

            async def weaver_search(args):
                query = args.get("query", "")
                results = await self.weaver.search(query)
                return json.dumps(results, indent=2)

            self.gateway.register_tool(ToolDefinition(
                name="weaver.retrieve", risk="safe", requires_approval=False,
                description="Retrieve relevant notes from the vault",
                parameters={"type":"object","properties":{"query":{"type":"string"},"limit":{"type":"integer","default":3}}},
                handler=weaver_retrieve
            ))
            self.gateway.register_tool(ToolDefinition(
                name="weaver.hot", risk="safe", requires_approval=False,
                description="Read the current HOT.md",
