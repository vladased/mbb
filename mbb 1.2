write_file("bb/providers/claude.py", '''
\"\"\"Claude (Anthropic) adapter.\"\"\"
import json
import httpx
from typing import AsyncIterator, Dict, Any, List, Optional
from .base import LLMProvider, ProviderRequest, ProviderEvent
from ..core.models import AssistantToolCall, Message, MessageRole

class ClaudeAdapter(LLMProvider):
    def __init__(self, api_key: str, default_model: str = "claude-3-5-sonnet-20241022"):
        self.api_key = api_key
        self._default_model = default_model

    def get_model_name(self) -> str:
        return self._default_model

    def get_context_limit(self) -> int:
        return 200000

    def _translate_tools(self, bb_tools: List[Dict]) -> List[Dict]:
        return [{
            "name": t["name"],
            "description": t.get("description", ""),
            "input_schema": t.get("parameters", {"type": "object", "properties": {}})
        } for t in bb_tools]

    def _translate_messages(self, messages: List[Message]) -> List[Dict]:
        translated = []
        for msg in messages:
            if msg.role == MessageRole.SYSTEM:
                continue
            elif msg.role == MessageRole.USER:
                translated.append({"role": "user", "content": msg.content})
            elif msg.role == MessageRole.ASSISTANT:
                if msg.tool_calls:
                    blocks = []
                    if msg.content:
                        blocks.append({"type": "text", "text": msg.content})
                    for tc in msg.tool_calls:
                        blocks.append({
                            "type": "tool_use",
                            "id": tc.id,
                            "name": tc.name,
                            "input": tc.arguments
                        })
                    translated.append({"role": "assistant", "content": blocks})
                else:
                    translated.append({"role": "assistant", "content": msg.content})
            elif msg.role == MessageRole.TOOL:
                translated.append({
                    "role": "user",
                    "content": [{
                        "type": "tool_result",
                        "tool_use_id": msg.tool_call_id,
                        "content": msg.content or "Success"
                    }]
                })
        return translated

    async def stream(self, request: ProviderRequest) -> AsyncIterator[ProviderEvent]:
        url = "https://api.anthropic.com/v1/messages"
        model = request.model if request.model else self._default_model
        payload = {
            "model": model,
            "system": request.system,
            "messages": self._translate_messages(request.conversation),
            "max_tokens": request.max_tokens,
            "temperature": request.temperature,
            "stream": True
        }
        tools = self._translate_tools(request.tools)
        if tools:
            payload["tools"] = tools

        headers = {
            "x-api-key": self.api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json"
        }

        async with httpx.AsyncClient(timeout=60.0) as client:
            async with client.stream("POST", url, json=payload, headers=headers) as response:
                if response.status_code != 200:
                    error_text = await response.aread()
                    yield ProviderEvent(type="error", error=f"Claude API error {response.status_code}: {error_text.decode()}")
                    return

                tool_blocks = {}
                async for line in response.aiter_lines():
                    if not line.startswith("data: "):
                        continue
                    data_str = line[6:].strip()
                    if data_str == "[DONE]":
                        continue
                    try:
                        data = json.loads(data_str)
                    except:
                        continue

                    etype = data.get("type")
                    if etype == "content_block_start":
                        block = data.get("content_block", {})
                        if block.get("type") == "tool_use":
                            idx = data.get("index")
                            tool_blocks[idx] = {
                                "id": block.get("id",""),
                                "name": block.get("name",""),
                                "arguments": ""
                            }
                    elif etype == "content_block_delta":
                        delta = data.get("delta", {})
                        if delta.get("type") == "text_delta":
                            yield ProviderEvent(type="text", text=delta.get("text",""))
                        elif delta.get("type") == "input_json_delta":
                            idx = data.get("index")
                            if idx in tool_blocks:
                                tool_blocks[idx]["arguments"] += delta.get("partial_json","")
                    elif etype == "content_block_stop":
                        idx = data.get("index")
                        if idx in tool_blocks:
                            block = tool_blocks.pop(idx)
                            try:
                                args = json.loads(block["arguments"]) if block["arguments"] else {}
                            except:
                                args = {}
                            yield ProviderEvent(
                                type="tool_call",
                                tool_call=AssistantToolCall(
                                    id=block["id"],
                                    name=block["name"],
                                    arguments=args
                                )
                            )
                    elif etype == "message_stop":
                        yield ProviderEvent(type="done")
                    elif etype == "error":
                        yield ProviderEvent(type="error", error=data.get("error",{}).get("message","Unknown error"))
''')

