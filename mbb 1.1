BASE = Path(__file__).parent / "bb_ios"
VERSION = "1.0.1"

def write_file(rel_path: str, content: str, executable: bool = False):
    full = BASE / rel_path
    full.parent.mkdir(parents=True, exist_ok=True)
    full.write_text(content, encoding="utf-8")
    if executable:
        full.chmod(0o755)

# ---- server.py (AUDITED) ----
write_file("server.py", '''#!/usr/bin/env python3
\"\"\"BB iOS – Main FastAPI server (audited v1.0.1).\"\"\"
import asyncio
import json
import secrets
import uuid
from pathlib import Path
from fastapi import FastAPI, Request, HTTPException, Depends, Header
from fastapi.responses import HTMLResponse, StreamingResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
import uvicorn

from bb.core.runtime import BBRuntime
from bb.core.context_builder import ContextBuilder
from bb.core.models import Message, MessageRole
from bb.core.credentials import CredentialManager
from bb.ios.keychain import KeychainManager
from bb.weaver.adapter import WeaverAdapter

# -----------------------------------------------------------------------------
# App initialization
# -----------------------------------------------------------------------------
app = FastAPI(title="BB iOS", version="1.0.1")
app.mount("/static", StaticFiles(directory="static"), name="static")

DATA_PATH = Path(__file__).parent / "data"
DATA_PATH.mkdir(exist_ok=True)

VAULT_PATH = DATA_PATH / "vault"
VAULT_PATH.mkdir(exist_ok=True)

runtime = BBRuntime(DATA_PATH, VAULT_PATH)

# Local auth token – stored in config.json for MVP.
# Future: migrate to iOS Keychain for persistent secure storage.
CONFIG_PATH = DATA_PATH / "config.json"
if CONFIG_PATH.exists():
    with open(CONFIG_PATH) as f:
        CONFIG = json.load(f)
else:
    CONFIG = {"local_auth_token": secrets.token_urlsafe(32)}
    with open(CONFIG_PATH, "w") as f:
        json.dump(CONFIG, f, indent=2)
LOCAL_AUTH_TOKEN = CONFIG["local_auth_token"]

def verify_token(x_api_key: str = Header(...)):
    if x_api_key != LOCAL_AUTH_TOKEN:
        raise HTTPException(status_code=401, detail="Invalid API key")

# -----------------------------------------------------------------------------
# Lifecycle
# -----------------------------------------------------------------------------
@app.on_event("startup")
async def startup():
    await runtime.start()

@app.on_event("shutdown")
async def shutdown():
    await runtime.stop()

# -----------------------------------------------------------------------------
# Endpoints
# -----------------------------------------------------------------------------
@app.get("/")
async def root():
    return HTMLResponse(open("static/index.html").read())

# AUDIT FIX: /chat now requires authentication
@app.post("/chat")
async def chat(
    request: Request,
    auth: str = Depends(verify_token)
):
    body = await request.json()
    user_input = body.get("text", "")
    session_id = body.get("session_id", str(uuid.uuid4()))
    agent_id = body.get("agent_id", "fable")

    # Enforce one stream per session
    queue = runtime.events.create_sse_queue(session_id)

    async def producer():
        try:
            await runtime.events.emit("session.start", {"session_id": session_id}, session_id=session_id)
            async for event in runtime.process(user_input, session_id, agent_id):
                await runtime.events.emit(event.type, event.__dict__, session_id=session_id)
            await runtime.events.emit("session.end", {}, session_id=session_id)
        except Exception as e:
            await runtime.events.emit("error", {"content": str(e)}, session_id=session_id)
            await runtime.events.emit("session.end", {}, session_id=session_id)

    async def event_generator():
        producer_task = asyncio.create_task(producer())
        try:
            while True:
                try:
                    event = await asyncio.wait_for(queue.get(), timeout=1.0)
                    yield f"data: {json.dumps(event)}\\n\\n"
                    if event.get("type") == "session.end":
                        break
                except asyncio.TimeoutError:
                    yield ": keepalive\\n\\n"
        except asyncio.CancelledError:
            pass
        finally:
            producer_task.cancel()
            runtime.events.remove_sse_queue(session_id)

    return StreamingResponse(event_generator(), media_type="text/event-stream")

@app.post("/approve")
async def approve_tool(request: Request, auth: str = Depends(verify_token)):
    body = await request.json()
    approval_id = body.get("approval_id")
    decision = body.get("decision")
    if decision == "allow":
        runtime.gateway.approve(approval_id)
        return JSONResponse({"status": "approved"})
    else:
        runtime.gateway.deny_approval(approval_id)
        return JSONResponse({"status": "denied"})

@app.post("/take_the_wheel")
async def take_the_wheel(auth: str = Depends(verify_token)):
    await runtime.set_human_override(True)
    return JSONResponse({"status": "human_override_enabled"})

@app.post("/release_the_wheel")
async def release_the_wheel(auth: str = Depends(verify_token)):
    await runtime.set_human_override(False)
    return JSONResponse({"status": "human_override_disabled"})

@app.get("/audit")
async def get_audit(auth: str = Depends(verify_token)):
    logs = runtime.audit.get_recent(20)
    return JSONResponse({"logs": logs})

@app.get("/agents")
async def list_agents(auth: str = Depends(verify_token)):
    return JSONResponse({
        "agents": [
            {"id": agent.id, "name": agent.name, "provider": agent.provider}
            for agent in runtime.agents.values()
        ]
    })

@app.post("/set_vault")
async def set_vault(request: Request, auth: str = Depends(verify_token)):
    body = await request.json()
    vault_path = Path(body.get("path", ""))
    if not vault_path.exists():
        return JSONResponse({"error": "Path does not exist"}, status_code=400)
    runtime.weaver = WeaverAdapter(vault_path)
    runtime.context_builder = ContextBuilder(runtime.weaver)
    await runtime.weaver.index()
    return JSONResponse({"status": "vault_updated", "path": str(vault_path)})

@app.post("/key")
async def set_key(request: Request, auth: str = Depends(verify_token)):
    body = await request.json()
    provider = body.get("provider")
    key = body.get("key")
    if not provider or not key:
        return JSONResponse({"error": "provider and key required"}, status_code=400)
    KeychainManager.set_key(provider, key)
    return JSONResponse({"status": "key_set", "provider": provider})

@app.get("/key/{provider}")
async def get_key(provider: str, auth: str = Depends(verify_token)):
    has = KeychainManager.get_key(provider) is not None
    return JSONResponse({"has_key": has})

@app.delete("/key/{provider}")
async def delete_key(provider: str, auth: str = Depends(verify_token)):
    KeychainManager.delete_key(provider)
    return JSONResponse({"status": "deleted"})

@app.post("/share")
async def share(request: Request, auth: str = Depends(verify_token)):
    body = await request.json()
    content = body.get("content", "")
    title = body.get("title", "")
    session_id = body.get("session_id") or str(uuid.uuid4())
    agent_id = body.get("agent_id", "fable")
    if not content:
        return JSONResponse({"error": "content required"}, status_code=400)
    prompt = f"Shared content:\\nTitle: {title}\\n\\n{content}"
    final_answer = []
    async for event in runtime.process(prompt, session_id, agent_id):
        if event.type == "text":
            final_answer.append(event.text or "")
        elif event.type == "done":
            break
    return JSONResponse({
        "status": "processed",
        "session_id": session_id,
        "answer": "".join(final_answer) if final_answer else "No response"
    })

if __name__ == "__main__":
    print(f"BB iOS v{VERSION}")
    print(f"Local auth token: {LOCAL_AUTH_TOKEN}")
    print("Server starting on http://0.0.0.0:5100")
    uvicorn.run(app, host="0.0.0.0", port=5100)
''', executable=True)

